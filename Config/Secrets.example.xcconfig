// Copie ce fichier en `Config/Secrets.xcconfig` (non commité) et renseigne tes valeurs.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// NB : pas de schéma "https://" ici (les `//` sont des commentaires en xcconfig) ;
// l'app reconstruit l'URL à partir de l'hôte.

SUPABASE_HOST = YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
SUPABASE_BUCKET = shared-photos
